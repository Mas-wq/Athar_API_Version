# Local development settings
PORT=5102
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL must be installed and running on this computer.
DATABASE_URL=postgresql://postgres:replace_with_your_postgres_password@localhost:5432/Athar
ADMIN_CONTACT_EMAIL=admin@athar.local
SHOW_LOCAL_VERIFICATION_CODES=true

# Groq chat key created under Default Project. Keep it private in server/.env.
GROQ_CHAT_API_KEY=add_your_chat_groq_api_key_here
GROQ_CHAT_MODEL=allam-2-7b
GROQ_CHAT_TIMEOUT_MS=30000

# Groq verification key created under Asset Verification.
# Qwen 3.8 27B handles text, photos, and claim evidence.
GROQ_VERIFICATION_API_KEY=add_your_verification_groq_api_key_here
GROQ_VERIFICATION_MODEL=qwen/qwen3.8-27b
GROQ_VERIFICATION_TIMEOUT_MS=60000

# Keep private verification details out of AI requests by default.
GROQ_INCLUDE_PRIVATE_CLAIM_DETAILS=false

# Local-only app secrets and seeded administrator
JWT_SECRET=generate_a_long_random_secret_before_running
ADMIN_EMAIL=admin@athar.local
ADMIN_PASSWORD=replace_with_a_unique_private_password
ADMIN_FULLNAME=Athar Admin
ADMIN_PHONE=01000000000
